assert(norm(g_NE-g_COM)<1e-10);




function [Mq,gq,U] = comEnergyTerms3R(q,L,mass,gmag)

    n = length(q);

    % 连杆累计转角
    alpha = cumsum(q);

    % 当前关节位置和质心位置
    pJoint = zeros(2,n);
    pCOM = zeros(2,n);

    for i = 2:n

        pJoint(:,i) = pJoint(:,i-1) ...
            + L(i-1)*[
                cos(alpha(i-1));
                sin(alpha(i-1))
            ];

    end

    for i = 1:n

        pCOM(:,i) = pJoint(:,i) ...
            + L(i)/2*[
                cos(alpha(i));
                sin(alpha(i))
            ];

    end

    Mq = zeros(n,n);
    gq = zeros(n,1);

    for i = 1:n

        %% 质心线速度雅可比
        Jvi = zeros(2,n);

        for j = 1:i

            r = pCOM(:,i)-pJoint(:,j);

            % z轴转动产生的质心线速度
            Jvi(:,j) = [-r(2);r(1)];

        end

        %% 角速度雅可比
        Jwi = zeros(1,n);
        Jwi(1:i) = 1;

        %% 绕质心z轴的转动惯量
        Izi = mass(i)*L(i)^2/12;

        %% 动能对应的质量矩阵
        Mq = Mq ...
            + mass(i)*(Jvi'*Jvi) ...
            + Izi*(Jwi'*Jwi);

        %% 势能对应的重力项
        gq = gq + mass(i)*gmag*Jvi(2,:)';

    end

    %% 总势能
    U = gmag*sum(mass'.*pCOM(2,:));

end


%% 52. 独立验证速度二次项

eps_fd = 1e-6;
n = length(q_test);

% dM_dq(:,:,k) = dM/dq_k
dM_dq = zeros(n,n,n);

for k = 1:n

    q_plus = q_test;
    q_minus = q_test;

    q_plus(k) = q_plus(k)+eps_fd;
    q_minus(k) = q_minus(k)-eps_fd;

    M_plus = comEnergyTerms3R( ...
        q_plus,L,mass,gmag);

    M_minus = comEnergyTerms3R( ...
        q_minus,L,mass,gmag);

    dM_dq(:,:,k) = ...
        (M_plus-M_minus)/(2*eps_fd);

end

% Christoffel符号构造速度二次项
c_COM = zeros(n,1);

for i = 1:n
    for j = 1:n
        for k = 1:n

            Gamma_ijk = 0.5*( ...
                dM_dq(i,j,k) ...
              + dM_dq(i,k,j) ...
              - dM_dq(j,k,i));

            c_COM(i) = c_COM(i) ...
                + Gamma_ijk*dq_test(j)*dq_test(k);

        end
    end
end

%% 53. 正向动力学验证

q_test = deg2rad([30;-40;50]);
dq_zero = zeros(3,1);

% 求静止保持力矩
tau_hold = inverseDynamicsNE( ...
    q_test,dq_zero,dq_zero,gravity, ...
    Mlist,Alist,Glist);

% 用保持力矩计算正向动力学
ddq_hold = forwardDynamicsNE( ...
    q_test,dq_zero,tau_hold,gravity, ...
    Mlist,Alist,Glist);

disp('施加重力补偿后的关节加速度:');
disp(ddq_hold);

assert(norm(ddq_hold)<1e-10);




%% 54. 无驱动力矩下的重力加速度

tau_free = zeros(3,1);

ddq_free = forwardDynamicsNE( ...
    q_test,dq_zero,tau_free,gravity, ...
    Mlist,Alist,Glist);

disp('重力作用下的关节角加速度:');
