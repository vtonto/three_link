
%% 50. 从牛顿-欧拉逆动力学构造 M, c, g

q_test = deg2rad([30; -40; 50]);
dq_test = [0.2; -0.1; 0.3];
ddq_test = [0.5; -0.2; 0.1];

n = length(q_test);

zero_q = zeros(n,1);
zero_g = zeros(3,1);

%% 1. 重力项
g_NE = inverseDynamicsNE( ...
    q_test,zero_q,zero_q,gravity, ...
    Mlist,Alist,Glist);

%% 2. 速度二次项
c_NE = inverseDynamicsNE( ...
    q_test,dq_test,zero_q,zero_g, ...
    Mlist,Alist,Glist);

%% 3. 质量矩阵
M_NE = zeros(n,n);

for j = 1:n

    % 第j个单位关节加速度
    ej = zeros(n,1);
    ej(j) = 1;

    % 得到质量矩阵第j列
    M_NE(:,j) = inverseDynamicsNE( ...
        q_test,zero_q,ej,zero_g, ...
        Mlist,Alist,Glist);

end

disp('质量矩阵 M(q):');
disp(M_NE);

disp('速度二次项 c(q,dq):');
disp(c_NE);

disp('重力项 g(q):');
disp(g_NE);

%% 4. 检查完整动力学分解

tau_direct = inverseDynamicsNE( ...
    q_test,dq_test,ddq_test,gravity, ...
    Mlist,Alist,Glist);

tau_decomp = M_NE*ddq_test + c_NE + g_NE;

fprintf('逆动力学分解误差: %.3e\n', ...
    norm(tau_direct-tau_decomp));

assert(norm(tau_direct-tau_decomp)<1e-10);

%% 5. 检查质量矩阵性质

err_sym = norm(M_NE-M_NE','fro');

lambda_M = eig(M_NE);

fprintf('质量矩阵对称误差: %.3e\n',err_sym);

disp('质量矩阵特征值:');
disp(lambda_M);

assert(err_sym<1e-10);
assert(all(lambda_M>0));

%% 6. 检查速度二次项性质

c_negative = inverseDynamicsNE( ...
    q_test,-dq_test,zero_q,zero_g, ...
    Mlist,Alist,Glist);

c_double = inverseDynamicsNE( ...
    q_test,2*dq_test,zero_q,zero_g, ...
    Mlist,Alist,Glist);

fprintf('速度反向检验误差: %.3e\n', ...
    norm(c_negative-c_NE));

fprintf('速度放大两倍检验误差: %.3e\n', ...
    norm(c_double-4*c_NE));


%% 51. 利用质心动能和势能交叉验证

gmag = 9.81;

[M_COM,g_COM,U_COM] = comEnergyTerms3R( ...
    q_test,L,mass,gmag);

disp('RNEA得到的质量矩阵:');
disp(M_NE);



disp('质心动能得到的质量矩阵:');
disp(M_COM);

fprintf('质量矩阵交叉验证误差: %.3e\n', ...
    norm(M_NE-M_COM,'fro'));

fprintf('重力项交叉验证误差: %.3e\n', ...
