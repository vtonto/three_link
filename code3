function [tau,V_all,dV_all,F_link] = ...
    inverseDynamicsNE(q,dq,ddq,gravity, ...
                      Mlist,Alist,Glist)

    n = length(q);

    %% 1. 计算当前相邻坐标系的伴随矩阵
    AdTi = zeros(6,6,n+1);

    for i = 1:n+1

        if i <= n

            % 当前相邻连杆位姿
            Trel = Mlist(:,:,i) ...
                * expm(twistHat(Alist(:,i))*q(i));

        else

            % 第三连杆质心到末端的固定变换
            Trel = Mlist(:,:,i);

        end

        % 刚体变换求逆
        R = Trel(1:3,1:3);
        p = Trel(1:3,4);

        Tinv = [
            R', -R'*p;
            zeros(1,3), 1
        ];

        AdTi(:,:,i) = adjointSE3(Tinv);

    end

    %% 2. 初始化
    V_all = zeros(6,n+1);
    dV_all = zeros(6,n+1);

    % 基座速度为零
    V_all(:,1) = zeros(6,1);

    % 通过基座加速度引入重力
    dV_all(:,1) = [zeros(3,1);-gravity];

    %% 3. 正向递推
    for i = 1:n

        Ai = Alist(:,i);
        AdT = AdTi(:,:,i);

        % 当前关节的相对运动
        Vrel = Ai*dq(i);

        % 速度
        Vi = AdT*V_all(:,i) + Vrel;

        % 有效加速度
        dVi = AdT*dV_all(:,i) ...
            + adSE3(Vi)*Vrel ...
            + Ai*ddq(i);

        V_all(:,i+1) = Vi;
        dV_all(:,i+1) = dVi;

    end

    %% 4. 反向递推
    tau = zeros(n,1);
    F_link = zeros(6,n);

    % 没有末端外部载荷
    F_next = zeros(6,1);

    for i = n:-1:1

        Vi = V_all(:,i+1);
        dVi = dV_all(:,i+1);

        Gi = Glist(:,:,i);
        Ai = Alist(:,i);

        % 连杆自身的动力学空间力
        F_self = Gi*dVi ...
            - adSE3(Vi)'*(Gi*Vi);

        % 下游空间力
        F_child = AdTi(:,:,i+1)'*F_next;

        % 总空间力
        Fi = F_self + F_child;

        % 关节力矩
        tau(i) = Ai'*Fi;

        % 保存
        F_link(:,i) = Fi;

        % 传递给上一根连杆
        F_next = Fi;

    end

end

