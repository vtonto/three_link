
%% 47. 牛顿-欧拉反向递推
%
% Fi = Gi*dVi
%    - ad(Vi)'*Gi*Vi
%    + Ad(T_i+1,i)'*Fi+1
%
% tau_i = Ai'*Fi

n = 3;

tau_NE = zeros(n,1);

% 存储每根连杆坐标系中表达的空间力
F_link = zeros(6,n);

% 末端没有外部载荷
F_next = zeros(6,1);

for i = n:-1:1

    % 第i根连杆的速度和有效加速度
    Vi = V_all(:,i+1);
    dVi = dV_all(:,i+1);

    % 第i根连杆的空间惯量
    Gi = Glist(:,:,i);

    % 当前关节旋量
    Ai = Alist(:,i);

    %% 1. 惯性项
    F_inertia = Gi*dVi;

    %% 2. 空间动量的速度耦合项
    Hi = Gi*Vi;

    F_velocity = -adSE3(Vi)'*Hi;

    %% 3. 下游连杆传递来的空间力
    AdT_child = AdTi(:,:,i+1);

    F_child = AdT_child'*F_next;

    %% 4. 当前连杆需要传递的总空间力
    Fi = F_inertia + F_velocity + F_child;

    %% 5. 投影到关节运动方向
    tau_NE(i) = Ai'*Fi;

    %% 6. 保存结果，准备上一根连杆
    F_link(:,i) = Fi;
    F_next = Fi;

    fprintf('\n===== 连杆%d =====\n',i);

    disp('惯性项 Gi*dVi:');
    disp(F_inertia);

    disp('速度耦合项:');
    disp(F_velocity);

    disp('下游传递的空间力:');
    disp(F_child);

    disp('总空间力 Fi:');
    disp(Fi);

    fprintf('关节力矩 tau_%d = %.8f Nm\n', ...
        i,tau_NE(i));

end

disp('牛顿-欧拉逆动力学力矩:');
disp(tau_NE);


